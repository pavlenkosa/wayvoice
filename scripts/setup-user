#!/bin/sh
set -eu
# Resolve the WayVoice CLI next to this script first, then via PATH, so the
# script works from a source checkout and from any installation prefix.
self="$0"
while [ -L "$self" ]; do
    link="$(readlink "$self")"
    case "$link" in
        /*) self="$link" ;;
        *) self="$(dirname "$self")/$link" ;;
    esac
done
bindir="$(cd "$(dirname "$self")" && pwd)"

if [ -x "$bindir/wayvoice" ]; then
    wayvoice_cmd="$bindir/wayvoice"
elif [ -n "${WAYVOICE_BINDIR:-}" ] && [ -x "$WAYVOICE_BINDIR/wayvoice" ]; then
    wayvoice_cmd="$WAYVOICE_BINDIR/wayvoice"
else
    wayvoice_cmd="wayvoice"
fi

# Apply the shortcut stored in the user's WayVoice config (F8 by default).
# The outcome is reported instead of being swallowed: this script runs after a
# dependency was installed, and "installed successfully" next to a shortcut that
# was never applied is exactly the combination that leaves a user with an app
# that does nothing and no reason why.
problems=0

if ! output="$("$wayvoice_cmd" apply-shortcut 2>&1)"; then
    printf 'setup-user: could not apply the global shortcut: %s\n' "$output" >&2
    problems=$((problems + 1))
fi

# ydotool may be installed later from backports.
if command -v ydotoold >/dev/null 2>&1; then
    if ! output="$(systemctl --user enable --now wayvoice-ydotool.service 2>&1)"; then
        printf 'setup-user: could not start ydotoold: %s\n' "$output" >&2
        problems=$((problems + 1))
    fi
fi

if [ "$problems" -gt 0 ]; then
    printf 'setup-user: %s step(s) did not complete; WayVoice will not react to the hotkey\n' "$problems" >&2
    exit 1
fi
exit 0
