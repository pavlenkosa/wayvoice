#!/bin/sh
# Start the ydotool daemon that ships with WayVoice.
#
# Installed as <prefix>/bin/wayvoice-ydotoold, next to the sources it belongs to.
# The bundled copy lives in ../lib/wayvoice/ydotool relative to this script, which
# is why nothing here names an installation prefix: the same file works under
# /usr, /usr/local or anywhere else the package was unpacked.
#
# The daemon that actually runs is chosen by wayvoice-ydotool.service, and it
# prefers a ydotoold from PATH over this one. This wrapper exists for the other
# two callers: the settings window asking whether automatic paste is available,
# and a user who wants to start it by hand.
set -eu

here="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
daemon="$here/../lib/wayvoice/ydotool/ydotoold"

# 78 is EX_CONFIG from sysexits.h, and it is not an arbitrary choice:
# wayvoice-ydotool.service restarts on failure, and this wrapper is installed whether
# or not the bundled binary was built. Exiting 1 made the unit restart every two
# seconds for the rest of the session, printing the same three lines each time, on a
# package that is working as intended - auto-paste simply falls back to the clipboard.
# The unit lists this code in RestartPreventExitStatus, so the wrapper is asked whether
# it can run and then stays quiet.
if [ ! -x "$daemon" ]; then
    echo "wayvoice-ydotoold: this package was built without a compiler, so the" >&2
    echo "bundled helper is not there. Install the distribution's ydotool, or" >&2
    echo "paste from the clipboard - both work." >&2
    exit 78
fi

exec "$daemon" "$@"
