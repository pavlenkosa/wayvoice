#!/bin/sh
# Entry point that prepares the Faster-Whisper engine (venv + pip install).
#
# Started by wayvoice-engine-setup.service; resolves the Python sources the
# same way as the other wrappers, so it works both from a source checkout and
# from the Debian package.
set -eu

self="$0"
# Resolve symlinks so that a symlinked wrapper still finds its own layout.
while [ -L "$self" ]; do
    link="$(readlink "$self")"
    case "$link" in
        /*) self="$link" ;;
        *) self="$(dirname "$self")/$link" ;;
    esac
done
bindir="$(cd "$(dirname "$self")" && pwd)"

for candidate in "$bindir/../lib/wayvoice/app/src" "$bindir/../app/src"; do
    if [ -d "$candidate/wayvoice" ]; then
        wayvoice_src="$(cd "$candidate" && pwd)"
        break
    fi
done

if [ -z "${wayvoice_src:-}" ]; then
    echo "wayvoice-engine-setup: cannot find the wayvoice Python package near $bindir" >&2
    echo "wayvoice-engine-setup: expected <prefix>/lib/wayvoice/app/src or <repo>/app/src" >&2
    exit 1
fi

PYTHONPATH="$wayvoice_src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
exec "${WAYVOICE_PYTHON:-python3}" -m wayvoice.engine_setup "$@"
