[Unit]
Description=WayVoice speech-to-text daemon
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
# A unit does not inherit the user's login PATH, so spell it out: this is what
# makes a bare "wayvoice-daemon" resolve regardless of the installation prefix
# (/usr, /usr/local, /opt, ...).
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh -c 'exec wayvoice-daemon'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
